# Variables de entorno de la plataforma. Copiar a `.env.local` y completar.
# Nunca versionar `.env.local` ni valores reales.
#
# Para desarrollo se usan las claves del proyecto de Supabase `piamonte-dev`
# (ref waezhdcznpzercgqyiaf, Project Settings -> API). Las claves de producción
# (`Piamonte`, ref czhbxmxhbyjpqhrpgihg) solo se usan para pruebas acordadas con el local.
# Ver docs/BASE-DE-DATOS.md.

# Pública (NEXT_PUBLIC_*: se expone al navegador). URL del proyecto de Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Pública (NEXT_PUBLIC_*: se expone al navegador). Clave "publishable" (anon) de Supabase.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Pública (NEXT_PUBLIC_*: se expone al navegador). Origen público del sitio, sin barra final.
# Se usa para construir enlaces de acceso de empleados (/admin/acceso).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo servidor. Clave service_role de Supabase. NUNCA exponerla al navegador ni
# registrarla en logs. La usan las rutas administrativas y scripts/.
SUPABASE_SERVICE_ROLE_KEY=
